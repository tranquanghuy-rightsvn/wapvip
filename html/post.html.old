  <!-- Post title -->
  <div class="hdr blue post-title">⬇ NRO 1.4.4 PreV5.9 <span class="hl">Android</span> - Hội Tụ Tất Cả Các Chức Năng Khủng Nhất HOT Nhất</div>

  <!-- Byline -->
  <div class="byline">
    <span class="click"><span>C</span><span>L</span><span>I</span><span>C</span><span>K</span></span>
    <span class="tag">Admin Đang Mua Nick</span> | <a href="#">Bán Nick</a> - Giá Hấp Dẫn
  </div>

  <!-- FB group callout -->
